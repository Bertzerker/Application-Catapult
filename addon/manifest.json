{
  "manifest_version": 2,
  "name": "Bewerbungskatapult",
  "version": "1.6.2",
  "description": "Personalisierte Bewerbungs-PDFs und Thunderbird-Entwürfe mit LibreOffice erstellen.",
  "browser_specific_settings": {"gecko": {"id": "bewerbungskatapult@application-catapult.local", "strict_min_version": "140.0"}},
  "permissions": ["accountsRead", "compose", "compose.save", "nativeMessaging", "storage"],
  "background": {"scripts": ["background.js"]},
  "browser_action": {"default_title": "Bewerbungskatapult öffnen"}
}
